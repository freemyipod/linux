config SND_SOC_APPLE_MCA
	tristate "Apple Silicon MCA driver"
	depends on ARCH_APPLE || COMPILE_TEST
	select SND_DMAENGINE_PCM
	default ARCH_APPLE
	help
	  This option enables an ASoC platform driver for MCA peripherals found
	  on Apple Silicon SoCs.

config SND_SOC_APPLE_NANO7
	tristate "iPod nano 7G audio machine"
	depends on SND_SOC
	select SND_SOC_APPLE_S5L8740_I2S
	help
	  Registers ASoC card: S5L8740 IIS CPU DAI + CS42/dummy codec.

config SND_SOC_APPLE_S5L8740_I2S
	tristate "S5L8740 IIS0 I2S CPU DAI"
	depends on SND_SOC && HAS_IOMEM
	select SND_SOC_GENERIC_DMAENGINE_PCM
	select SND_DMAENGINE_PCM
	help
	  IIS0 @0x3CA00000 CPU DAI with optional PL080 dmaengine PCM.

config SND_SOC_APPLE_CS42L81_SPI
	tristate "CS42L81 / 338S1146 SPI control (N31)"
	depends on SPI
	help
	  RetailOS-matched SPI0 framing (0x6C/0x6D) and corpus bring-up.
