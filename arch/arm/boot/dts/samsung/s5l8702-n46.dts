// SPDX-License-Identifier: GPL-2.0+
/*
 * Apple iPod nano 3rd generation (N46)
 * SoC: Samsung/Apple S5L8702 (ARM926EJ-S)
 */
/dts-v1/;
#include <dt-bindings/clock/samsung,s5l8702-clock.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Apple iPod nano (3rd generation)";
	compatible = "apple,n46", "samsung,s5l8702";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:57600n8";
	};

	/* Crystal reference: 12 MHz */
	clkref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <12000000>;
		clock-output-names = "clkref";
	};

	/* 32.768 kHz crystal */
	osc1: clock-osc1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "osc1";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,arm926ej-s";
			reg = <0>;
		};
	};

	memory@8000000 {
		device_type = "memory";
		/* 32 MB SDRAM */
		reg = <0x08000000 0x02000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		vic0: interrupt-controller@38e00000 {
			compatible = "arm,pl192-vic";
			interrupt-controller;
			reg = <0x38e00000 0x1000>;
			#interrupt-cells = <1>;
		};

		vic1: interrupt-controller@38e01000 {
			compatible = "arm,pl192-vic";
			interrupt-controller;
			reg = <0x38e01000 0x1000>;
			#interrupt-cells = <1>;
		};

		timer: timer@3c700000 {
			compatible = "samsung,s5l8702-timer";
			reg = <0x3c700000 0x20000>;
			interrupt-parent = <&vic0>;
			interrupts = <7>;
		};

		uart0: serial@3cc00000 {
			compatible = "apple,s5l-uart";
			reg = <0x3cc00000 0x4000>;
			reg-io-width = <4>;
			clocks = <&clkref>, <&clkref>;
			clock-names = "uart", "clk_uart_baud0";
			interrupt-parent = <&vic0>;
			interrupts = <24>;
			status = "okay";
		};

		usbphy: usbphy@3c400000 {
			compatible = "apple,s5l8702-otgphy";
			reg = <0x3c400000 0x200>;
			status = "okay";
			#phy-cells = <0>;
		};

		usbotg: usb@38400000 {
			compatible = "apple,s5l87xx-usb";
			reg = <0x38400000 0x40000>;
			interrupt-parent = <&vic0>;
			interrupts = <19>;
			phys = <&usbphy>;
			phy-names = "usb2-phy";
			clocks = <&clkctrl CLK_USBOTG>;
			clock-names = "otg";
			g-rx-fifo-size = <536>;
			g-np-tx-fifo-size = <256>;
			g-tx-fifo-size = <256 256 512 512 512 768 768>;
			dr_mode = "peripheral";
			status = "okay";
		};

		i2c0: i2c@3c600000 {
			compatible = "samsung,s5l8702-i2c";
			reg = <0x3c600000 0x100>;
			clock-frequency = <100000>;
			clocks = <&clkctrl CLK_I2C0>;
			interrupt-parent = <&vic0>;
			interrupts = <21>;
			samsung,write-busy-poll;
			status = "okay";
		};

		/*
		 * SPI0: boot NOR flash (SST25-series, 4 MB).
		 * CS is controlled manually via GPIOCMD; no cs-gpios needed.
		 * Clock divider is fixed at 4 (PClk/5) by the driver.
		 */
		spi0: spi@3c300000 {
			compatible = "apple,s5l8702-spi";
			reg = <0x3c300000 0x50>;
			clocks = <&clkctrl CLK_SPI0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <25000000>;
			};
		};

		/*
		 * LCD controller: custom 8080-series MPU interface block
		 * driving an ILI93xx-family panel (auto-detected at probe).
		 */
		lcd: lcd@38300000 {
			compatible = "apple,s5l8702-lcd";
			reg = <0x38300000 0x100>;
			clocks = <&clkctrl CLK_LCD>;
			pmu-i2c = <&i2c0>;
			status = "okay";
		};

		/*
		 * FMI (Flash Memory Interface) for the on-board NAND.
		 * The driver still sets the GPIO pinmux (PCON8..10) itself.
		 */
		nand: nand@38a00000 {
			compatible = "apple,s5l8702-nand";
			reg = <0x38a00000 0x400>;
			clocks = <&clkctrl CLK_NAND>, <&clkctrl CLK_NANDECC>;
			clock-names = "nand", "ecc";
			pmu-i2c = <&i2c0>;
			apple,nand-bank = <0>;
			status = "okay";
		};

		clkctrl: clock-controller@3c500000 {
			compatible = "samsung,s5l8702-clock";
			reg = <0x3c500000 0x100>;
			clocks = <&clkref>, <&osc1>;
			clock-names = "osc0", "osc1";
			#clock-cells = <1>;
		};

		/*
		 * GPIO pins 0..127 (port * 8 + pin). Pin interrupts come from
		 * the external interrupt controller in the "system alive"
		 * block, whose GPIO groups feed VIC0 lines 0..3.
		 */
		gpio: gpio-controller@3cf00000 {
			compatible = "apple,s5l8702-gpio";
			reg = <0x3cf00000 0x204>, <0x39a00080 0x80>;
			clocks = <&clkctrl CLK_GPIO>;
			interrupt-parent = <&vic0>;
			interrupts = <0>, <1>, <2>, <3>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		/*
		 * ARM PL080 DMA controllers. Request lines (first cell):
		 *  dmac0: 0/1 I2S2 tx/rx, 2 SPDIF tx, 3 LCD, 4/5 SPI0,
		 *         6/7 UART0, 8/9 UART1, 10/11 I2S0, 12/13 SPI2,
		 *         14/15 SPI1
		 *  dmac1: 0/1 CE-ATA, 2/3 I2S1, 4/5 I2S2, 6/7 SPI1,
		 *         8/9 UART2, 10/11 SPI0, 12/13 UART3, 14/15 SPI2
		 * Rockbox uses AHB master 1 for everything (second cell = 1).
		 * The PrimeCell ID is forced in case the silicon doesn't
		 * report a standard one.
		 */
		dmac0: dma-controller@38200000 {
			compatible = "arm,pl080", "arm,primecell";
			arm,primecell-periphid = <0x00041080>;
			reg = <0x38200000 0x1000>;
			interrupt-parent = <&vic0>;
			interrupts = <16>;
			clocks = <&clkctrl CLK_DMAC0>;
			clock-names = "apb_pclk";
			lli-bus-interface-ahb1;
			mem-bus-interface-ahb1;
			memcpy-burst-size = <16>;
			memcpy-bus-width = <32>;
			#dma-cells = <2>;
		};

		dmac1: dma-controller@39900000 {
			compatible = "arm,pl080", "arm,primecell";
			arm,primecell-periphid = <0x00041080>;
			reg = <0x39900000 0x1000>;
			interrupt-parent = <&vic0>;
			interrupts = <17>;
			clocks = <&clkctrl CLK_DMAC1>;
			clock-names = "apb_pclk";
			lli-bus-interface-ahb1;
			mem-bus-interface-ahb1;
			memcpy-burst-size = <16>;
			memcpy-bus-width = <32>;
			#dma-cells = <2>;
		};

		/*
		 * Watchdog. Only its reset behaviour is known: writing
		 * 0x100000 to WDTCON resets the SoC (Rockbox system_reboot).
		 */
		wdt: watchdog@3c800000 {
			compatible = "apple,s5l8702-wdt", "syscon", "simple-mfd";
			reg = <0x3c800000 0x8>;

			reboot {
				compatible = "syscon-reboot";
				offset = <0x0>;
				value = <0x100000>;
			};
		};

		sha1: sha1@38000000 {
			compatible = "samsung,s5l8702-sha1";
			reg = <0x38000000 0x100>;
			clocks = <&clkctrl CLK_SHA1>;
			clock-names = "sha1";
		};
	};
};
